    {
        "id": "92d994a8c47c6d3e",
        "type": "function",
        "z": "00faea911c2e17d1",
        "name": "Simulate Smart Desk",
        "func": "// Simple Smart Desk simulator\n\n// Random helper\nfunction rand(min, max) {\n    return Math.round(Math.random() * (max - min) + min);\n}\n\n// Decide if user is present (60% chance present)\nconst present = Math.random() < 0.6;\n\n// If present, focusScore between 50–95, else 0\nlet focusScore = present ? rand(50, 95) : 0;\n\n// Light level (simulated 20–90)\nlet lightLevel = rand(20, 90);\n\n// Posture: 1 = good, 0 = bad (70% good if present)\nlet postureGood = 1;\nif (present) {\n    postureGood = Math.random() < 0.7 ? 1 : 0;\n} else {\n    postureGood = 0; // not at desk → no posture\n}\n\n// Build payload\nconst payload = {\n    deskId: \"desk01\",\n    userId: \"user01\",\n    present: present,\n    focusScore: focusScore,\n    lightLevel: lightLevel,\n    postureGood: postureGood,\n    ts: new Date().toISOString()\n};\n\n// Set MQTT topic here\nmsg.topic = \"desk/desk01/telemetry\";\nmsg.payload = JSON.stringify(payload);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 120,
        "wires": [
            [
                "34345f3168db1b64"
            ]
        ]
    },
