    {
        "id": "8c58fa0660fa325d",
        "type": "function",
        "z": "00faea911c2e17d1",
        "name": "Prepare Influx point",
        "func": "// Get the payload from the message\nlet p = msg.payload;\n\n// If payload is a JSON string, try to parse it\nif (typeof p === \"string\") {\n    try {\n        p = JSON.parse(p);\n    } catch (e) {\n        node.warn(\"Payload is a string but not valid JSON: \" + e.message);\n        return null;\n    }\n}\n\n// We now expect p to be an object\nif (!p || typeof p !== \"object\") {\n    node.warn(\"No valid payload object received\");\n    return null;\n}\n\n// Basic validation\nif (!p.deskId || !p.userId) {\n    node.warn(\"Missing deskId or userId\");\n    return null;\n}\n\n// Convert booleans to numbers for Influx\nconst presentVal = p.present ? 1 : 0;\n\n// ---- Influx mapping ----\nmsg.measurement = \"desk_focus\";\n\nmsg.tags = {\n    deskId: p.deskId,\n    userId: p.userId\n};\n\n// IMPORTANT: fields must go in msg.payload\nmsg.payload = {\n    present: presentVal,\n    focusScore: Number(p.focusScore) || 0,\n    lightLevel: Number(p.lightLevel) || 0,\n    postureGood: Number(p.postureGood) || 0\n};\n\n// Timestamp for Influx\nmsg.timestamp = p.ts ? new Date(p.ts) : new Date();\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "\n",
        "finalize": "",
